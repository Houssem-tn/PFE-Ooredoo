<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Patch bump only (4.0.2 -> 4.0.7, same 4.0.x line) — fixes a
             real Trivy-reported Critical CVE (CVE-2026-40976, Spring Boot
             security-bypass) and transitively brings the BOM-managed
             tomcat-embed-core/spring-security-web versions up to their
             own fixed releases too (verified via `mvn dependency:tree`
             after this bump — see the image-scan fix commit; 4.0.6 alone
             wasn't enough, tomcat-embed-core still landed one patch
             short of its own fixed version). -->
        <version>4.0.7</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com</groupId>
    <artifactId>pfe</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>PFE</name>
    <description>PFE</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
        <!-- SonarQube — see SONAR.md for the project-structure decision (two
             separate projects, backend/frontend, since these are two
             independent git repositories). Never hardcode host/token here;
             pass -Dsonar.host.url / -Dsonar.token on the command line. -->
        <sonar.projectKey>ooredoo-backend</sonar.projectKey>
        <sonar.projectName>Ooredoo FSM - Backend</sonar.projectName>
        <sonar.sources>src/main/java</sonar.sources>
        <sonar.tests>src/test/java</sonar.tests>
        <sonar.java.binaries>target/classes</sonar.java.binaries>
        <sonar.java.test.binaries>target/test-classes</sonar.java.test.binaries>
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- DTOs/entities/models are plain data holders (getters/setters/builders) —
             excluded from coverage expectations and duplication detection
             (builder boilerplate naturally repeats) but NOT from general
             analysis, so a genuine bug (e.g. broken equals/hashCode) is
             still caught. -->
        <sonar.coverage.exclusions>**/dto/**,**/model/**,**/entity/**,**/*Application.java</sonar.coverage.exclusions>
        <sonar.cpd.exclusions>**/dto/**,**/model/**,**/entity/**</sonar.cpd.exclusions>
        <!-- NVD_API_KEY is read from the environment by the dependency-check
             plugin itself (nvdApiKeyEnvironmentVariable below) — never set a
             literal key here. -->
        <!-- Pinned above Spring Boot 4.0.7's managed 11.0.22: fixes real,
             actively-flagged CVEs in the rewrite valve and EncryptInterceptor
             docs (CVE-2026-53434, CVE-2026-55276, CVE-2026-59083,
             CVE-2026-59084, CVE-2026-53404 — all fixed by 11.0.23/11.0.24).
             Remove this override once spring-boot-starter-parent ships a
             patch release that pins >= 11.0.24 on its own. -->
        <tomcat.version>11.0.24</tomcat.version>
    </properties>
    <dependencies>
        <!-- Web (correct starter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: container/orchestrator health checks, plus (as of the
             observability phase) the Prometheus scrape endpoint. Exposure is
             locked down to health + prometheus + info only (see
             application.properties / management.endpoints.web.exposure.include)
             — never widen this without also reviewing what each endpoint leaks
             (env/beans/configprops/heapdump/logfile/mappings must never be
             exposed — see OBSERVABILITY_BACKUP.md "Backend metrics"). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer's Prometheus registry — spring-boot-starter-actuator
             alone only wires Micrometer's core API, not an exporter; this is
             what actually makes /actuator/prometheus exist. Version is
             managed by the spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Structured JSON logging (logback-spring.xml) for centralized
             log collection (Loki) — see OBSERVABILITY_BACKUP.md "Logging
             fields". -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>

        <!-- logback-spring.xml uses a Janino <if> conditional to switch
             between the JSON and plain-text appender based on the
             LOGGING_JSON_ENABLED property — Janino is logback's own
             documented mechanism for conditional configuration blocks, not
             a general scripting/expression-language dependency. -->
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
            <version>3.1.12</version>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation (@Valid, @NotBlank, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.5.5.Final</version>
        </dependency>

        <!-- Security test support (optional but recommended) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

         <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Explicit even though spring-boot-starter-data-mongodb-test pulls it in transitively,
             so JUnit/Mockito/AssertJ don't silently disappear if that dependency is ever changed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.11.0</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio</artifactId>
            <version>3.5.0</version>
        </dependency>

    </dependencies>

    <!-- Pins a transitive dependency's version up to a patched release
         without touching the library that actually pulls it in.
         io.minio:minio:8.6.0 (declared above) brings in
         org.bouncycastle:bcprov-jdk18on:1.81, which a real Trivy image
         scan flagged as CVE-2025-14813 (Critical). 1.81.1 is BouncyCastle's
         own smallest/most conservative patch release that fixes it — not
         jumping to the newest 1.8x line — and minio's own version is left
         alone entirely. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.81.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>

                    <annotationProcessorPaths>
                        <!-- Lombok processor -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>

                        <!-- (optional but recommended if you use MapStruct) -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.5.5.Final</version>
                        </path>

                        <!-- (recommended) avoids Lombok+MapStruct issues -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Repackages target/pfe-<version>.jar into an executable Spring
                 Boot fat jar (embedded deps + BOOT-INF + Main-Class). Without
                 this explicit declaration, spring-boot-starter-parent only
                 provides plugin-management defaults — it does NOT bind
                 repackage to the build — so `java -jar` would fail. Required
                 for the container runtime image, which runs the jar directly
                 (no `mvnw spring-boot:run`). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage reporting only (informational) — no build-breaking threshold yet.
                 Report: target/site/jacoco/index.html after `mvnw clean verify`. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ── Maven Enforcer ──────────────────────────────────────────────
                 Cheap, fast sanity checks bound to `validate` so they run on
                 every build. All rules here match the toolchain already in
                 use — nothing here should surprise a developer building
                 locally today. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,18)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <!-- Known-vulnerable / obsolete artifacts that have no
                                     legitimate reason to appear, direct or transitive. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-core:(,2.17.1)</exclude>
                                        <exclude>commons-collections:commons-collections:(,3.2.2)</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── Checkstyle ──────────────────────────────────────────────────
                 `mvnw checkstyle:check` (ad hoc, uses this <configuration>
                 with the default failOnViolation=true) is the blocking gate
                 for CI to call later. The `verify`-bound execution below
                 overrides failOnViolation=false so today's `clean verify`
                 keeps passing while still producing the report — see
                 config/checkstyle/checkstyle.xml for the severity split
                 between blocking and informational rules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <violationSeverity>error</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-report-on-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <failOnViolation>false</failOnViolation>
                            <failsOnError>false</failsOnError>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── SpotBugs ────────────────────────────────────────────────────
                 Same blocking/non-blocking split as Checkstyle:
                 `mvnw spotbugs:check` is the strict standalone gate;
                 the verify-bound execution only reports. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.6</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>config/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
                    <xmlOutput>true</xmlOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-report-on-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <failOnError>false</failOnError>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── OWASP Dependency-Check ──────────────────────────────────────
                 Standalone: `mvnw dependency-check:check`. Not bound to the
                 lifecycle (an NVD sync can be slow/rate-limited and the local
                 dev inner loop shouldn't pay that cost on every build).
                 Set NVD_API_KEY in the environment for a reliable/fast sync —
                 see NVD_API_KEY usage below; never commit the key itself. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.1.3</version>
                <configuration>
                    <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- Fail only on High/Critical (CVSS >= 7); Medium/Low are
                         visible in the report but non-blocking for now, per
                         the project's baseline strategy. -->
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFiles>
                        <suppressionFile>config/dependency-check/suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <!-- Sonatype OSS Index is a supplementary, unauthenticated
                         vulnerability data source layered on top of the NVD
                         analyzer above. GitHub-hosted runners share IP pools
                         across every public CI job worldwide, and OSS Index's
                         anonymous quota is small enough that shared pool
                         reliably exhausts it — confirmed 2026-07-25: every
                         single dependency 401'd, escalating to a hard
                         MojoExecutionException that aborted the scan before
                         it ever reached CVE matching. The NVD analyzer
                         (authenticated via NVD_API_KEY above) is the actual
                         CVE/CPE-matching engine and is unaffected — it's what
                         found every real finding fixed/suppressed in this
                         project so far. Revisit if OSS Index credentials
                         (OSSINDEX_USERNAME/OSSINDEX_TOKEN, free registration
                         at ossindex.sonatype.org) are ever configured. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
