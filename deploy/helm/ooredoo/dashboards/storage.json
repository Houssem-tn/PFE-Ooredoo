{
  "title": "Ooredoo - Storage (MongoDB / MinIO)",
  "uid": "ooredoo-storage",
  "schemaVersion": 39,
  "tags": ["ooredoo"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "MongoDB availability",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "kube_statefulset_status_replicas_ready{namespace=~\"$namespace\", statefulset=\"mongodb\"}", "legendFormat": "ready" }
      ]
    },
    {
      "id": 2,
      "title": "MinIO availability",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "kube_statefulset_status_replicas_ready{namespace=~\"$namespace\", statefulset=\"minio\"}", "legendFormat": "ready" }
      ]
    },
    {
      "id": 3,
      "title": "mongodb-data PVC usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "100 * (1 - kubelet_volume_stats_available_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"mongodb-data.*\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"mongodb-data.*\"})", "legendFormat": "% used" }
      ]
    },
    {
      "id": 4,
      "title": "minio-data PVC usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "100 * (1 - kubelet_volume_stats_available_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"minio-data.*\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"minio-data.*\"})", "legendFormat": "% used" }
      ]
    },
    {
      "id": 5,
      "title": "MinIO upload failures (fallback-to-local rate)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(minio_upload_failures_total{namespace=~\"$namespace\"}[15m]))", "legendFormat": "failures/15m" }
      ]
    },
    {
      "id": 6,
      "title": "Last successful backup age (hours)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "(time() - kube_cronjob_status_last_successful_time{namespace=~\"$namespace\", cronjob=~\"mongodb-backup|minio-backup\"}) / 3600", "legendFormat": "{{cronjob}}" }
      ]
    }
  ],
  "templating": {
    "list": [
      { "name": "namespace", "type": "textbox", "current": { "text": "ooredoo-staging", "value": "ooredoo-staging" }, "label": "Namespace" }
    ]
  }
}
