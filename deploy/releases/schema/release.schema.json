{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Houssem-tn/PFE-Ooredoo/deploy/releases/schema/release.schema.json",
  "title": "Ooredoo release manifest",
  "description": "Machine-readable record of exactly what was built, scanned and (optionally) deployed for one release. Generated by .github/workflows/release.yml - never hand-edited. Contains no secrets, tokens or kubeconfig data by design (see the top-level 'no secrets' rule enforced by ci/validate-release-manifest.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseId",
    "releaseTimestamp",
    "sources",
    "images",
    "helm",
    "workflowRuns",
    "securityScans",
    "sbom",
    "targetEnvironment",
    "previousReleaseId"
  ],
  "properties": {
    "releaseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Unique identifier for this release, e.g. a run ID or vMAJOR.MINOR.PATCH tag."
    },
    "releaseTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp of when this manifest was generated."
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "ocr"],
      "properties": {
        "backend": { "$ref": "#/definitions/sourceRef" },
        "frontend": { "$ref": "#/definitions/sourceRef" },
        "ocr": { "$ref": "#/definitions/sourceRef" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "ocr"],
      "properties": {
        "backend": { "$ref": "#/definitions/imageRef" },
        "frontend": { "$ref": "#/definitions/imageRef" },
        "ocr": { "$ref": "#/definitions/imageRef" }
      }
    },
    "helm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chartName", "chartVersion", "releaseRevision"],
      "properties": {
        "chartName": { "type": "string" },
        "chartVersion": { "type": "string" },
        "releaseRevision": {
          "type": ["integer", "null"],
          "description": "The Helm release revision this manifest was deployed as, if known at generation time. Null when the manifest is generated before deployment."
        }
      }
    },
    "workflowRuns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backendCi", "frontendCi", "ocrCi", "release"],
      "properties": {
        "backendCi": { "type": ["string", "null"] },
        "frontendCi": { "type": ["string", "null"] },
        "ocrCi": { "type": ["string", "null"] },
        "release": { "type": ["string", "null"] },
        "deployStaging": { "type": ["string", "null"] }
      }
    },
    "securityScans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "ocr"],
      "properties": {
        "backend": { "$ref": "#/definitions/scanStatus" },
        "frontend": { "$ref": "#/definitions/scanStatus" },
        "ocr": { "$ref": "#/definitions/scanStatus" }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "ocr"],
      "properties": {
        "backend": { "$ref": "#/definitions/sbomRef" },
        "frontend": { "$ref": "#/definitions/sbomRef" },
        "ocr": { "$ref": "#/definitions/sbomRef" }
      }
    },
    "targetEnvironment": {
      "type": "string",
      "enum": ["staging", "production"]
    },
    "previousReleaseId": {
      "type": ["string", "null"],
      "description": "releaseId of the release this one supersedes, or null for the first release."
    }
  },
  "definitions": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": { "type": "string", "description": "owner/repo" },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "scanStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trivyCritical", "trivyHigh", "gitleaks"],
      "properties": {
        "trivyCritical": { "type": "string", "enum": ["pass", "fail", "not_run"] },
        "trivyHigh": { "type": "string", "enum": ["pass", "advisory_findings", "not_run"] },
        "gitleaks": { "type": "string", "enum": ["pass", "fail", "not_run"] }
      }
    },
    "sbomRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactName", "format"],
      "properties": {
        "artifactName": { "type": "string" },
        "format": { "type": "string", "enum": ["cyclonedx-json"] }
      }
    }
  }
}
