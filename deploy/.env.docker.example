# =========================================================================
# Local Docker Compose environment configuration.
#
# Copy this file to `.env.docker` (git-ignored — see DOCKER.md) and fill in
# real values. Never commit `.env.docker`, never reuse a secret from
# another environment, and never paste real values into this *.example*
# file.
#
# Usage: docker compose --env-file .env.docker up -d
# (Compose does not auto-load a file named .env.docker — it only
# auto-loads a file literally named `.env`. Either pass --env-file
# explicitly every time, as documented in DOCKER.md, or copy this file to
# plain `.env` instead if you prefer Compose's automatic loading.)
#
# How to generate a strong secret (any of these; 32+ random bytes):
#   Linux/macOS : openssl rand -base64 48
#   Windows     : powershell -Command "[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))"
#   Cross-platform: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# =========================================================================

COMPOSE_PROJECT_NAME=pfe

# =========================
# Backend — Spring profile
# =========================
# `dev` on purpose for the default docker-compose.yml — see DOCKER.md
# "Which Spring profile does Compose use, and why" for the full reasoning.
# Short version: the frontend's nginx reverse-proxies /api and
# /ws-notifications same-origin, so the browser never makes a
# cross-origin request straight to the backend — meaning
# APP_CORS_ALLOWED_ORIGINS / APP_FRONTEND_URL have no real CORS effect in
# this topology, which makes `prod` profile's strict
# "no localhost anywhere" validation actively unhelpful for a
# machine-local integration environment. `prod` profile IS exercised, on
# purpose, via the separate docker-compose.prod-check.yml override — see
# DOCKER.md.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# =========================
# MongoDB
# =========================
# Used both to configure the mongodb container's root user (see
# MONGO_INITDB_ROOT_USERNAME/PASSWORD in docker-compose.yml) and to build
# the backend's MONGODB_URI (mongodb://user:pass@mongodb:27017/db) —
# never "localhost", the backend reaches Mongo via the Compose service
# name.
MONGODB_DATABASE=pfe
MONGODB_USERNAME=pfe_app
MONGODB_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# =========================
# JWT
# =========================
# 32+ random characters. Must NOT be the source-code dev placeholder
# ("dev-secret-change-me-...") — ProductionSafetyEnvironmentPostProcessor
# rejects both when SPRING_PROFILES_ACTIVE=prod, but generate a real one
# unconditionally; app.jwt.secret has no safe shared default.
APP_JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret_32_chars_min
APP_JWT_EXPIRATION=86400000

# =========================
# CORS / frontend URL
# =========================
# See the SPRING_PROFILES_ACTIVE comment above: functionally inert in the
# default (dev-profile) compose topology since nginx proxies same-origin.
# Kept as real-looking, non-localhost values anyway so
# docker-compose.prod-check.yml can reuse this same .env.docker file
# unchanged. Replace with your actual origin(s) only if you expose the
# backend directly (bypassing the nginx proxy) in some other setup.
APP_CORS_ALLOWED_ORIGINS=http://frontend
APP_FRONTEND_URL=http://frontend

# =========================
# MinIO
# =========================
# Root credentials for the minio container itself (MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD in docker-compose.yml) and for the backend's MinIO
# client. Must NOT be the "minioadmin"/"minioadmin" pair — MinIO requires
# MINIO_ROOT_PASSWORD to be 8+ characters regardless, but pick something
# actually random.
MINIO_ACCESS_KEY=CHANGE_ME_generate_a_random_access_key
MINIO_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key
MINIO_BUCKET=pfe-files

# =========================
# OCR microservice
# =========================
# http://ocr:8000/extract — Compose service name, matches
# EacyOCR/app/main.py's @app.post("/extract"). Only reachable/meaningful
# when the OCR service is actually running — see DOCKER.md "ocr" profile.
OCR_API_URL=http://ocr:8000/extract

# =========================
# Mail (disabled by default — no SMTP account needed for local testing)
# =========================
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail: use an App Password, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# =========================
# Frontend — MapTiler
# =========================
# Browser-visible, NOT a secret — see
# Pfe-Oreedoo-Front/src/environments/environment.production.ts's own
# comments. The real security boundary is restricting this key to your
# domain(s) in the MapTiler dashboard, not hiding it from the built JS
# bundle (which is impossible for any client-side map key regardless of
# how it's injected).
MAPTILER_KEY=
