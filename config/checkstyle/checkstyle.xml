<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Baseline Checkstyle configuration for PFE-Ooredoo.

  Deliberately NOT a full Sun/Google style rewrite — see the project's
  testing/quality baseline strategy: this project is large and pre-existing,
  so rules are split into two severities:

    - severity="error"   -> real maintainability/correctness risks that are
                             genuinely rare in the current codebase (verified
                             by running the checker before deciding, not
                             assumed). These are the ones `mvnw
                             checkstyle:check` fails the build on (see
                             pom.xml violationSeverity=error).
    - severity="warning"  -> known, WIDESPREAD legacy debt. Reported, not
                             blocking, until the team pays it down
                             deliberately. Confirmed widespread by an actual
                             run, not a guess:
                               - wildcard imports: 108 files (mostly
                                 `import lombok.*;`)
                               - missing braces (NeedBraces/EmptyBlock):
                                 300+ occurrences across many services —
                                 initially assumed rare, corrected after the
                                 first real `checkstyle:check` run.

  Do not bump warning-severity checks to error without first running
  `mvnw checkstyle:check` and checking how many files it would suddenly fail.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Excludes generated/build output; Maven only feeds src/main/java and
         src/test/java to this config via <sourceDirectories> anyway, but
         keep this as a defensive backstop. -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="[\\/]target[\\/]"/>
    </module>

    <!-- Long lines: legacy debt (435 of ~49000 lines exceed 120 chars
         today), reported not blocking. 140 is a deliberately generous
         threshold so this doesn't fire on every already-acceptable line. -->
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="severity" value="warning"/>
        <!-- Long import lines / URLs in comments are not worth flagging. -->
        <property name="ignorePattern" value="^import |^\s*\*\s*@see |https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Imports ─────────────────────────────────────────────────── -->

        <!-- Wildcard imports: widespread legacy pattern (108 files, mostly
             `import lombok.*;`). Flag but do not block. -->
        <module name="AvoidStarImport">
            <property name="severity" value="warning"/>
        </module>

        <!-- Real dead-weight imports are rare and worth catching eagerly. -->
        <module name="RedundantImport">
            <property name="severity" value="error"/>
        </module>
        <module name="UnusedImports">
            <property name="severity" value="error"/>
            <property name="processJavadoc" value="false"/>
        </module>

        <!-- ── Naming conventions ──────────────────────────────────────── -->

        <module name="TypeName">
            <property name="severity" value="error"/>
        </module>
        <!-- Standard camelCase, with optional underscore-separated BDD-style
             suffixes allowed (e.g. `login_shouldRejectInvalidCredentials`) —
             this project's established JUnit convention (see
             src/test/java/**/*Test.java). Still rejects real naming abuse
             (PascalCase, ALL_CAPS, single letters, leading underscore). -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z][a-zA-Z0-9]*)*$"/>
            <property name="severity" value="error"/>
        </module>
        <module name="MemberName">
            <property name="severity" value="error"/>
        </module>
        <module name="LocalVariableName">
            <property name="severity" value="error"/>
        </module>
        <!-- Lombok's @Slf4j (used throughout this project) generates a
             `private static final Logger log;` field — lowercase by
             long-standing, universal Lombok/SLF4J convention. Some classes
             use a named variant (e.g. `auditLog`) for a second, purpose-
             specific logger. Allow both rather than flagging every logger
             field. -->
        <module name="ConstantName">
            <property name="severity" value="error"/>
            <property name="format" value="^([a-zA-Z][a-zA-Z0-9]*)?[Ll]og(ger)?$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="PackageName">
            <property name="severity" value="error"/>
        </module>

        <!-- ── Block structure ──────────────────────────────────────────── -->

        <!-- Genuinely rare and worth catching: an empty catch block silently
             swallowing an exception is a real defect shape. -->
        <module name="EmptyCatchBlock">
            <property name="severity" value="error"/>
            <property name="exceptionVariableName" value="expected|ignored|ignore"/>
        </module>

        <!-- Missing braces / empty non-catch blocks (empty if/for/while
             bodies, single-statement bodies without braces): confirmed
             WIDESPREAD across this codebase (300+ occurrences) on the first
             real run — legacy debt, not a rare defect signature here.
             Reported, not blocking. -->
        <module name="EmptyBlock">
            <property name="severity" value="warning"/>
            <property name="option" value="text"/>
            <property name="tokens"
                      value="LITERAL_WHILE,LITERAL_TRY,LITERAL_FINALLY,LITERAL_DO,LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,INSTANCE_INIT,STATIC_INIT,LITERAL_SWITCH,LITERAL_SYNCHRONIZED"/>
        </module>
        <module name="NeedBraces">
            <property name="severity" value="warning"/>
        </module>

        <!-- ── Package declaration sanity ──────────────────────────────── -->

        <module name="PackageDeclaration">
            <property name="severity" value="error"/>
        </module>
        <module name="OuterTypeFilename">
            <property name="severity" value="error"/>
        </module>

        <!-- ── Structural consistency — informational only for now ─────── -->

        <module name="UnusedLocalVariable">
            <property name="severity" value="warning"/>
        </module>
        <module name="EqualsHashCode">
            <property name="severity" value="error"/>
        </module>
        <module name="ModifierOrder">
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
