# Copy this file to `.env` (or export these as real environment variables)
# and fill in real values. `.env` is git-ignored and must never be committed.
#
# This project does not auto-load .env files at runtime (plain Spring Boot).
# Export it via your shell, IDE run config, or process manager before
# starting the app. See README.md "Configuration" section for full examples
# (PowerShell / bash) per Spring profile (dev / test / prod).
#
# Profile selection:
SPRING_PROFILES_ACTIVE=dev

# =========================================================================
# Values below have safe localhost/dev fallbacks in application-dev.properties
# and application-test.properties. They become REQUIRED (no fallback) when
# SPRING_PROFILES_ACTIVE=prod — see application-prod.properties and
# ProductionSafetyValidator, which fails startup clearly if any are missing
# or still look like dev defaults.
# =========================================================================

SERVER_PORT=8080

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/pfe

# --- JWT ---
# Production: use a long, random value (32+ chars). Never reuse the
# source-code dev placeholder.
APP_JWT_SECRET=
APP_JWT_EXPIRATION=86400000

# --- Mail / SMTP ---
# MAIL_ENABLED defaults to false in dev, true in prod. When enabled,
# MAIL_USERNAME/MAIL_PASSWORD are required.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail: use an App Password, not your account password.
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional; defaults to MAIL_USERNAME if unset.
MAIL_FROM=

# --- MinIO ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pfe-files

# --- CORS ---
# Comma-separated list of allowed frontend origins. Required (no default) in prod.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost:4200,https://127.0.0.1:4200

# --- Frontend URL (used to build links in emails, e.g. tech invitations) ---
APP_FRONTEND_URL=http://localhost:4200

# --- OCR microservice ---
OCR_API_URL=http://localhost:8000/extract

# --- Storage ---
APP_STORAGE_LOCAL_DIR=

# --- SLA (Activation RDV) ---
APP_SLA_RDV_WINDOW=6h
APP_SLA_WARNING_THRESHOLD=0.5
APP_SLA_SCHEDULER_DELAY_MS=30000
APP_SLA_ESCALATION_THRESHOLD_MINUTES=30
